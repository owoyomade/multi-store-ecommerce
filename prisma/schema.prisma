// Database schema. Phase 1 covers identity, stores, memberships and audit logs.
// Catalog, orders and payments tables are added in later phases.
//
// Conventions:
// - Every table that belongs to a store has a `storeId` column. Service code
//   must always filter by it (see src/server/tenancy).
// - Table names are snake_case plurals via @@map; Prisma model names stay PascalCase.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Identity (shape required by Better Auth)

enum PlatformRole {
  USER
  SUPER_ADMIN
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  // Only changeable from the database or seed script, never through sign-up.
  platformRole  PlatformRole @default(USER)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sessions         Session[]
  accounts         Account[]
  storeMemberships StoreMembership[]
  invitesSent      StoreInvite[]     @relation("InvitedBy")
  auditLogs        AuditLog[]
  customers        Customer[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

// One row per sign-in method. For email + password, `password` holds the hash.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

// Short-lived tokens for email verification and password reset.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// Stores (tenants)

enum StoreStatus {
  DRAFT // created, not visible to shoppers yet
  ACTIVE // published
  SUSPENDED // switched off by a platform admin
}

model Store {
  id             String      @id @default(cuid())
  name           String
  // Used in URLs (/s/northbrew) and subdomains, so it is unique platform-wide.
  slug           String      @unique
  status         StoreStatus @default(DRAFT)
  // ISO 4217 code such as "CAD". All prices in this store use this currency.
  currency       String      @db.Char(3)
  // ISO 3166-1 alpha-2 code such as "CA".
  country        String      @db.Char(2)
  contactEmail   String
  primaryColor   String      @default("#1f2937")
  accentColor    String      @default("#f59e0b")
  theme          StoreTheme  @default(CLASSIC)
  // One line shown in the storefront hero, e.g. "Small-batch coffee, roasted in Toronto".
  tagline        String?
  logoStorageKey String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  // Soft delete: old orders must keep pointing at a real store row.
  deletedAt      DateTime?

  settings           StoreSettings?
  memberships        StoreMembership[]
  invites            StoreInvite[]
  auditLogs          AuditLog[]
  products           Product[]
  collections        Collection[]
  inventoryLocations InventoryLocation[]
  carts              Cart[]
  customers          Customer[]
  orders             Order[]

  @@index([status])
  @@map("stores")
}

// Storefront look. Each theme changes typography and layout, not just colours,
// so two stores can look clearly different.
enum StoreTheme {
  CLASSIC // serif headings, soft corners, warm feel
  BOLD // uppercase sans-serif, square corners, high contrast
}

// Settings that change rarely and are only read by the dashboard and checkout.
// Tax and shipping are demo rules, not authoritative tax calculations.
model StoreSettings {
  storeId               String   @id
  store                 Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // Basis points: 1300 = 13.00%. Integers avoid floating-point rounding.
  demoTaxRateBps        Int      @default(0)
  flatShippingCents     Int      @default(0)
  freeShippingOverCents Int?
  lowStockThreshold     Int      @default(5)
  // Next human-friendly order number (#1001, #1002, ...). Incremented
  // atomically when an order is created, so numbers are unique per store.
  nextOrderNumber       Int      @default(1001)
  updatedAt             DateTime @updatedAt

  @@map("store_settings")
}

enum StoreRole {
  OWNER
  MANAGER
  INVENTORY_EDITOR
  FULFILLMENT_AGENT
}

// Links a user to a store with a role. A user can belong to many stores.
model StoreMembership {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      StoreRole
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([storeId, userId])
  @@index([userId])
  @@map("store_memberships")
}

model StoreInvite {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email       String
  role        StoreRole
  // SHA-256 of the token in the invite link. The raw token is only ever in the email.
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([storeId, email])
  @@map("store_invites")
}

// Audit trail

// Append-only record of sensitive actions. Store IDs and entity IDs only:
// no emails, addresses or other personal data in `metadata`.
model AuditLog {
  id          String   @id @default(cuid())
  storeId     String?
  store       Store?   @relation(fields: [storeId], references: [id])
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([storeId, createdAt])
  @@map("audit_logs")
}

// Catalog

enum ProductStatus {
  DRAFT // only visible in the dashboard
  PUBLISHED // visible on the storefront
  ARCHIVED // hidden everywhere except old orders and the dashboard's archive filter
}

model Product {
  id             String        @id @default(cuid())
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title          String
  // Unique per store, not platform-wide: two stores can both sell "classic-tee".
  slug           String
  description    String        @default("")
  status         ProductStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  options     ProductOption[]
  variants    ProductVariant[]
  images      ProductImage[]
  collections CollectionProduct[]

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@map("products")
}

// An option such as "Size" with values ["S", "M", "L"]. At most two per product.
model ProductOption {
  id        String   @id @default(cuid())
  storeId   String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  values    String[]
  position  Int

  @@unique([productId, position])
  @@map("product_options")
}

// The thing a shopper actually buys: one combination of option values.
// A product without options has exactly one variant.
model ProductVariant {
  id                  String    @id @default(cuid())
  storeId             String
  productId           String
  product             Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  // e.g. "M / Black", or "Default" when the product has no options.
  title               String
  // Values in the same order as the product's options, e.g. ["M", "Black"].
  optionValues        String[]
  sku                 String
  priceCents          Int
  // The "was" price shown crossed out. Must be higher than priceCents when set.
  compareAtPriceCents Int?
  trackInventory      Boolean   @default(true)
  position            Int
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  // Variants removed from a product are archived, not deleted, so the stock
  // ledger and future order history keep pointing at a real row.
  archivedAt          DateTime?

  inventoryLevels    InventoryLevel[]
  inventoryMovements InventoryMovement[]
  cartItems          CartItem[]
  orderItems         OrderItem[]

  @@unique([storeId, sku])
  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id         String   @id @default(cuid())
  storeId    String
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Path inside the storage driver, e.g. "stores/<storeId>/products/<uuid>.webp".
  storageKey String   @unique
  altText    String   @default("")
  width      Int
  height     Int
  position   Int
  createdAt  DateTime @default(now())

  @@index([productId, position])
  @@map("product_images")
}

model Collection {
  id          String              @id @default(cuid())
  storeId     String
  store       Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  description String              @default("")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  products    CollectionProduct[]

  @@unique([storeId, slug])
  @@map("collections")
}

model CollectionProduct {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  position     Int        @default(0)

  @@id([collectionId, productId])
  @@index([productId])
  @@map("collection_products")
}

// Inventory

// One default location per store for now; multi-location is a later phase.
model InventoryLocation {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  levels    InventoryLevel[]
  movements InventoryMovement[]

  @@index([storeId])
  @@map("inventory_locations")
}

// Current stock for one variant at one location.
// "Available to sell" is onHand - reserved; reservations arrive with checkout in Phase 3.
model InventoryLevel {
  id         String            @id @default(cuid())
  storeId    String
  variantId  String
  variant    ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId String
  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  onHand     Int               @default(0)
  reserved   Int               @default(0)
  updatedAt  DateTime          @updatedAt

  @@unique([variantId, locationId])
  @@index([storeId])
  @@map("inventory_levels")
}

enum InventoryMovementReason {
  INITIAL_STOCK
  ADJUSTMENT
  RESTOCK
  SALE
  RETURN
}

// Append-only ledger: every change to onHand writes one row here, so stock
// levels can always be explained and audited.
model InventoryMovement {
  id          String                  @id @default(cuid())
  storeId     String
  variantId   String
  variant     ProductVariant          @relation(fields: [variantId], references: [id], onDelete: Restrict)
  locationId  String
  location    InventoryLocation       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  delta       Int
  reason      InventoryMovementReason
  actorUserId String?
  // Set for SALE movements so stock changes can be traced to an order.
  orderId     String?
  note        String?
  createdAt   DateTime                @default(now())

  @@index([storeId, createdAt])
  @@index([variantId])
  @@map("inventory_movements")
}

// Shopping cart

// A cart belongs to one store. The browser holds a random token in a cookie;
// the cart stores variant IDs and quantities only — prices are always read
// fresh from the catalog, so a shopper can never change what they pay.
model Cart {
  id        String     @id @default(cuid())
  storeId   String
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // SHA-256 of the cookie token. A leaked database row can't be turned back into a working cookie.
  tokenHash String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@index([storeId])
  @@map("carts")
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// Customers and orders

// A shopper as seen by one store. Created at checkout (guest or signed in).
// The same person buying from two stores is two Customer rows, so stores
// never see each other's customer lists.
model Customer {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email     String
  name      String
  // Linked when the shopper was signed in, so they can see their order history.
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  addresses Address[]
  orders    Order[]

  @@unique([storeId, email])
  @@index([userId])
  @@map("customers")
}

model Address {
  id         String   @id @default(cuid())
  storeId    String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  line1      String
  line2      String   @default("")
  city       String
  region     String   @default("")
  postalCode String
  country    String   @db.Char(2)
  phone      String   @default("")
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@map("addresses")
}

enum OrderStatus {
  PENDING // created at checkout, waiting for payment; stock is reserved
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id                   String      @id @default(cuid())
  storeId              String
  store                Store       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  orderNumber          Int
  customerId           String
  customer             Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // Copied at checkout: later changes to the customer don't rewrite old orders.
  email                String
  status               OrderStatus @default(PENDING)
  currency             String      @db.Char(3)
  subtotalCents        Int
  shippingCents        Int
  taxCents             Int
  totalCents           Int
  // Snapshot of the address at checkout: { name, line1, line2, city, region, postalCode, country, phone }.
  shippingAddress      Json
  // Stock stays reserved for this order until this time, then is released.
  reservationExpiresAt DateTime
  // The cart that became this order; emptied once payment succeeds.
  cartId               String?
  // The browser's checkout attempt ID. Submitting the same checkout twice
  // (double click, retry) finds this order instead of creating a second one.
  idempotencyKey       String      @unique
  paidAt               DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]

  @@unique([storeId, orderNumber])
  @@index([storeId, status, createdAt])
  @@index([customerId])
  @@map("orders")
}

// One product line on an order. Titles, SKU and price are copied at
// purchase time so the order stays accurate if the product changes later.
model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productTitle   String
  variantTitle   String
  sku            String
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int
  // Whether stock was reserved for this line (untracked variants aren't).
  stockReserved  Boolean         @default(false)

  @@index([orderId])
  @@map("order_items")
}

// Every status change, who made it (null = the system, e.g. a payment webhook) and why.
model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorUserId String?
  note        String?
  createdAt   DateTime     @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// Payments

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
}

model Payment {
  id                String        @id @default(cuid())
  storeId           String
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String
  // e.g. the Stripe Checkout Session ID.
  providerSessionId String        @unique
  // e.g. the Stripe PaymentIntent ID, known once the shopper pays.
  providerPaymentId String?
  // Where the shopper completes payment. Re-used if the same checkout is submitted twice.
  checkoutUrl       String?
  amountCents       Int
  currency          String        @db.Char(3)
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  events PaymentEvent[]

  @@index([orderId])
  @@map("payments")
}

// Human-readable history of what happened to a payment.
model PaymentEvent {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type      String
  details   Json?
  createdAt DateTime @default(now())

  @@index([paymentId])
  @@map("payment_events")
}

// Every webhook we've processed. The unique constraint is what makes
// processing idempotent: providers retry deliveries, and a repeat of an event
// we've already handled is recognised and skipped.
model WebhookEvent {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String
  type            String
  receivedAt      DateTime @default(now())

  @@unique([provider, providerEventId])
  @@map("webhook_events")
}
