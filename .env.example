# Copy this file to `.env` and adjust if needed. Never commit `.env`.
# The values below match docker-compose.yml and are for local development only.

# Postgres
DATABASE_URL="postgresql://shop:shop_dev_password@localhost:5440/shop_dev"
TEST_DATABASE_URL="postgresql://shop:shop_dev_password@localhost:5440/shop_test"

# Public URL of the app (used in emails and auth callbacks)
APP_URL="http://localhost:3210"

# Better Auth: generate your own with `openssl rand -base64 32`
BETTER_AUTH_SECRET="replace-with-a-long-random-string"

# Outgoing email (Mailpit locally; a real SMTP provider in staging)
SMTP_HOST="localhost"
SMTP_PORT="1030"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Multi-Store Demo <no-reply@example.test>"

# Password given to every demo account created by `npm run db:seed`.
# Local demo data only — choose your own, and never reuse a real password.
SEED_DEMO_PASSWORD="demo-store-password"

# Where uploaded images are saved in development (git-ignored)
STORAGE_DIR="storage"

# Stripe TEST mode only (https://dashboard.stripe.com/test/apikeys).
# Leave empty to run without payments; checkout will say it's unavailable.
STRIPE_SECRET_KEY=""
# Printed by `stripe listen --events checkout.session.completed,checkout.session.expired --forward-to localhost:3210/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=""

# Optional: also POST each server error report (JSON) to this URL, e.g. an
# error-tracking service's ingest endpoint. Leave empty to only log errors.
ERROR_REPORT_URL=""
