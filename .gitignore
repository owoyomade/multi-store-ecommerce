# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the env template public (placeholders only, no real secrets)
!.env.example

# local AI-assistant files: kept on this machine, never published
CLAUDE.md
.claude/
# AGENTS.md is regenerated by `next dev` with assistant instructions
AGENTS.md

# local file uploads (product images in development)
/storage/

# test artifacts
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# logs
*.log

# generated Prisma client (rebuilt by `npm install` / `npm run db:generate`)
/src/generated/

# design-tool working files (screenshots, reports)
/.taste-skill/
/.impeccable/
